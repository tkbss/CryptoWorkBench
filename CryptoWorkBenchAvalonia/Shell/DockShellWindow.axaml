<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:prism="http://prismlibrary.com/"
        x:Class="CryptoWorkBenchAvalonia.Shell.DockShellWindow"
        prism:ViewModelLocator.AutoWireViewModel="False"
        Title="CryptoWorkBench" Width="1200" Height="760" MinWidth="640" MinHeight="420"
        Icon="/Assets/avalonia-logo.ico">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <Button x:Name="McpConnectButton" DockPanel.Dock="Right" Content="Connect Codex…" IsVisible="False" Margin="4" />
      <Menu x:Name="ShellMenu" />
    </DockPanel>
    <Border x:Name="ShellStatusBar" DockPanel.Dock="Bottom" Padding="8,3" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CwbBorderSubtleBrush}" Background="{DynamicResource CwbSurfacePanelBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <SelectableTextBlock x:Name="ExecutionStatus" Text="Ready" FontSize="12" />
            <SelectableTextBlock x:Name="ShellStatus" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Column="1" x:Name="CaretStatus" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <dock:DockControl x:Name="DockHost" />
  </DockPanel>
</Window>
