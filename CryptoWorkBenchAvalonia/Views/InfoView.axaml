<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="using:CryptoWorkBenchAvalonia.ViewModels"  
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:mdt="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:mde="clr-namespace:Markdown.Avalonia.Extensions;assembly=Markdown.Avalonia"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CryptoWorkBenchAvalonia.Views.InfoView">   
    <Grid RowDefinitions="Auto,*">
        <!--<html:HtmlPanel ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                        ScrollViewer.VerticalScrollBarVisibility="Auto" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch" 
                        Text="{Binding InfoHtml}" /> -->
        <Button Grid.Row="0"
                Content="← Mechanisms"
                Command="{Binding ShowMechanismsCommand}"
                IsVisible="{Binding IsInternalMechanismDetail}"
                HorizontalAlignment="Left"
                Margin="10,8,10,0"
                Padding="6,2"
                Background="Transparent" />
    <md:MarkdownScrollViewer x:Name="InfoMarkdownViewer"
                             Grid.Row="1"
                             Classes.mechanism="{Binding IsMechanismDocumentation}"
                             Margin="10"
                             ScrollViewer.AllowAutoHide="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch"
                              Markdown="{Binding InfoText}">
        <md:MarkdownScrollViewer.Engine>
            <mdt:Markdown />
        </md:MarkdownScrollViewer.Engine>
        <md:MarkdownScrollViewer.Styles>
            <!-- Fluent H1 uses 3.2 times the theme size; halve only mechanism titles. -->
            <Style Selector="md|MarkdownScrollViewer.mechanism ctxt|CTextBlock.Heading1">
                <Setter Property="FontSize" Value="{mde:Multiply ControlContentThemeFontSize, 1.8}" />
                <Setter Property="FontWeight" Value="DemiBold" />
            </Style>
        </md:MarkdownScrollViewer.Styles>
    </md:MarkdownScrollViewer>
    
   </Grid>
</UserControl>
