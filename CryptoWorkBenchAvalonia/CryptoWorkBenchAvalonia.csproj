<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Preserve Avalonia 11 reflection-binding semantics during the framework migration. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  
  <ItemGroup>
    <None Remove="CBC-AES-128-TEST-NIST-SP800-38A.sbk" />
    <None Remove="CBC-AES-192-TEST-NIST-SP800-38A.sbk" />
    <None Remove="CBC-AES-256-TEST-NIST-SP800-38A.sbk" />
    <None Remove="ScriptBook.sbk" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <!-- Keep the runtime loader aligned with the application Avalonia version. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />


    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.344" />
	<PackageReference Include="Markdown.Avalonia" Version="12.0.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <!-- MessageBox's minimum is a nightly; select the compatible stable release. -->
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
    <ProjectReference Include="../.deps/prism/src/Avalonia/Prism.Avalonia/Prism.Avalonia.csproj" />
    <ProjectReference Include="../.deps/prism/src/Avalonia/Prism.DryIoc.Avalonia/Prism.DryIoc.Avalonia.csproj" />
    <PackageReference Include="UVtools.AvaloniaControls" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CryptoScript\CryptoScript.csproj" />
    <ProjectReference Include="..\CryptoWorkBench.Automation.Abstractions\CryptoWorkBench.Automation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Update="Assets\avalonia-logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
  </ItemGroup>
</Project>
