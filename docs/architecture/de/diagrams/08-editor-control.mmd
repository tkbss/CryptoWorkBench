stateDiagram-v2
  [*] --> Unavailable
  %% event attach
  Unavailable --> Gui: Editor anbinden
  %% event acquire
  Gui --> Mcp: Lease bei passender Revision erwerben
  %% event conflict
  Gui --> Gui: Belegt oder Konflikt
  %% event edit-renew
  Mcp --> Mcp: Verlängern oder ändern
  %% event end-lease
  Mcp --> Releasing: Freigabe, Ablauf, Ablösung oder Widerruf
  %% event gui-return
  Releasing --> Gui: Ursprünglicher Editor bereit
  %% event detached
  Releasing --> Unavailable: Editor abgelöst
  %% event native-fault
  Mcp --> Faulted: Nativer Abschlussfehler
  %% event drain-fault
  Releasing --> Faulted: Fehler beim Abschluss
  %% event protect
  Faulted --> Faulted: Schreibzugriff gesperrt
